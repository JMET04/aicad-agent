* text=auto eol=lf
# Showcase files are content-addressed review artifacts. Preserve their exact
# verified bytes instead of applying checkout/index newline normalization.

# Magic-wand mechanical outputs are hash-bound native/review evidence. Keep
# their generated bytes stable so a clone verifies against the same SHA-256.
projects/magic-wand/mechanical/** -text whitespace=cr-at-eol
showcase/** -text whitespace=cr-at-eol

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.dwg binary
*.sldprt binary
*.SLDPRT binary
*.sldasm binary
*.SLDASM binary
*.step binary
*.STEP binary
*.stp binary
*.STP binary
*.dll binary
*.exe binary
