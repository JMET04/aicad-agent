  "workflow": [
    {"id": "WF-00", "order": 0, "label": "领域与任务冻结", "objective": "识别专业、用途、阶段、输出和安全边界", "exitGate": "上下文指纹和高影响假设完整"},
    {"id": "WF-01", "order": 1, "label": "规范与经验召回", "objective": "加载完整权威规则库存并分离候选经验", "exitGate": "适用规则、版本、范围和来源无遗漏"},
    {"id": "WF-02", "order": 2, "label": "专业预检", "objective": "把每条规则转换为生成约束和验证方法", "exitGate": "所有必需门禁有真实来源证据且无模板占位"},
    {"id": "WF-03", "order": 3, "label": "受约束生成", "objective": "用可追踪对象、关系、依赖和参数生成候选", "exitGate": "意图、细节、几何和工件闭包独立通过"},
    {"id": "WF-04", "order": 4, "label": "跨专业协调", "objective": "复核接口、净空、荷载、坐标、能源和维护空间", "exitGate": "受影响覆盖项已按当前变更标签重检"},
    {"id": "WF-05", "order": 5, "label": "原生宿主与制造验证", "objective": "保存重开、分析、图纸、BOM和制造输出同版闭合", "exitGate": "原生证据和哈希闭包完整"},
    {"id": "WF-06", "order": 6, "label": "独立审查与放行", "objective": "区分候选、技术审查、制造授权和发布", "exitGate": "负责工程师/主管机构/工厂按项目职责签发"}
  ],
  "cards": [
    {
      "id": "EXP-GLOBAL-001",
      "title": "先锁定规范与权威，再生成几何",
      "severity": "blocker",
      "required": true,
      "workflowStage": "WF-00",
      "whyRecalled": "所有工程专业都必须先冻结领域、阶段、标准和来源优先级。",
      "domains": ["*"],
      "deliveryStages": ["*"],
      "match": {"all": [], "any": [], "none": []},
      "ruleRefs": [
        {"sourceId": "normative", "ruleId": "NORM-G001"},
        {"sourceId": "normative", "ruleId": "NORM-G002"},
        {"sourceId": "normative", "ruleId": "NORM-G003"},
        {"sourceId": "normative", "ruleId": "NORM-G004"},
        {"sourceId": "production", "ruleId": "PROD-G001"}
      ],
      "checklist": [
        "领域、用途、交付阶段、司法辖区和输出类型均已声明。",
        "每条适用标准都绑定版次、范围和权威来源。",
        "高影响假设在几何前确认；图片和偏好不覆盖标准或工程输入。"
      ],
      "invalidatedBy": ["requirements", "standards", "jurisdiction", "delivery_stage"],
      "reusableArtifacts": ["design-context.json", "authority-ledger.json", "standards-ledger.json"],
      "estimatedReviewMinutesAvoided": 30
    },
    {
      "id": "EXP-GLOBAL-002",
      "title": "完整覆盖账本，禁止修一漏一",
      "severity": "blocker",
      "required": true,
      "workflowStage": "WF-04",
      "whyRecalled": "任何单点修复都可能让相邻约束、接口或制造证据过期。",
