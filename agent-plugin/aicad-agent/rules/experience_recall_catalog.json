      "deliveryStages": ["*"],
      "match": {"all": [], "any": [], "none": []},
      "ruleRefs": [
        {"sourceId": "production", "ruleId": "PROD-G002"},
        {"sourceId": "production", "ruleId": "PROD-G013"},
        {"sourceId": "cad_quality", "ruleId": "CAD-Q006"}
      ],
      "checklist": [
        "预期检查键与实际账本严格双向相等，无缺项、重复项和额外项。",
        "每个通过项绑定当前输入证据；受变更标签影响的旧通过项必须失效并重检。",
        "失败、待定或未授权不适用项不能被总分、视觉效果或无关通过项抵消。"
