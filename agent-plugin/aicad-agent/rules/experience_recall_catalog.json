    {
      "id": "EXP-MECH-002",
      "title": "手持电子外壳的承力、IMU、天线与电池必须解耦",
      "severity": "high",
      "required": false,
      "workflowStage": "WF-04",
      "whyRecalled": "手持动作设备同时受刚度、跌落、射频、热、维修和人体工学约束。",
      "domains": ["mechanical", "product_design"],
      "deliveryStages": ["prototype", "engineering_review", "production"],
      "match": {"all": ["handheld_device"], "any": ["battery", "radio", "motion_control", "enclosure"], "none": []},
      "ruleRefs": [
        {"sourceId": "production", "ruleId": "PROD-G006"},
        {"sourceId": "production", "ruleId": "PROD-G011"}
