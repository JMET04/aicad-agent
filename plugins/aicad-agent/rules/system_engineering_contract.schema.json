{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicad.local/schemas/system_engineering_contract.schema.json",
  "title": "AICAD System Engineering Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "systemId", "revision", "intendedUse", "prohibitedUses",
    "requirements", "subsystems", "artifacts", "interfaces", "flows",
    "verificationGates", "changeImpacts", "evidenceBindings", "authorizations",
    "releaseLocks"
  ],
  "properties": {
    "schema": {"const": "aicad.system-engineering-contract.v1"},
    "systemId": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "intendedUse": {"type": "string", "minLength": 1},
    "prohibitedUses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requirements": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "subsystems": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/subsystem"}
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "interfaces": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/interface"}
    },
    "flows": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/flow"}
    },
    "verificationGates": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    },
    "changeImpacts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/changeImpact"}
    },
    "evidenceBindings": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "authorizations": {
      "type": "object", "additionalProperties": false,
      "required": ["prototypeBuild", "productionRelease"],
      "properties": {
        "prototypeBuild": {"type": "boolean"},
        "productionRelease": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "releaseLocks": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewOnly", "technicalReady", "physicalVerified", "productionReleaseEligible"],
      "properties": {
        "reviewOnly": {"type": "boolean"},
        "technicalReady": {"type": "boolean"},
        "physicalVerified": {"type": "boolean"},
        "productionReleaseEligible": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["defined", "generated", "tool_verified", "physical_verified", "released", "blocked"]
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "verificationMethod", "subsystemIds", "gateIds", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]{3}$"},
        "statement": {"type": "string", "minLength": 1},
        "verificationMethod": {"type": "string", "minLength": 1},
        "subsystemIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "gateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "subsystem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "domain", "scope", "artifactIds", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "domain": {
          "enum": ["mechanical", "electronics", "firmware", "packaging", "civil", "architecture", "manufacturing", "systems", "other"]
        },
        "scope": {"type": "string", "minLength": 1},
        "artifactIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "status": {"$ref": "#/$defs/status"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subsystemId", "kind", "path", "evidenceLevel", "evidenceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "subsystemId": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "evidenceLevel": {"$ref": "#/$defs/status"},
        "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value", "unit", "authority"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "string", "boolean"]},
        "unit": {"type": ["string", "null"]},
        "tolerance": {"type": ["number", "string", "null"]},
        "authority": {"type": "string", "minLength": 1}
      }
    },
    "interface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "providerSubsystemId", "consumerSubsystemId", "contract", "parameters", "verificationGateIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["mechanical", "electrical", "data", "energy", "thermal", "rf", "human", "manufacturing", "site", "other"]},
        "providerSubsystemId": {"type": "string", "minLength": 1},
        "consumerSubsystemId": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/parameter"}},
        "verificationGateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "flow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "orderedSubsystemIds", "interfaceIds", "failureState"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["energy", "signal", "data", "force", "thermal", "material", "fluid", "human", "manufacturing"]},
        "orderedSubsystemIds": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "interfaceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "failureState": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirementIds", "requiredEvidenceLevel", "verification", "status", "evidenceIds"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirementIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "requiredEvidenceLevel": {"$ref": "#/$defs/status"},
        "verification": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "passed", "failed", "blocked"]},
        "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "changeImpact": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "impactedIds", "requiredRechecks"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "impactedIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "requiredRechecks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "size", "sha256", "level"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "level": {"$ref": "#/$defs/status"},
        "toolVersion": {"type": ["string", "null"]}
      }
    }
  }
}
